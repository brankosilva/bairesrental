# Copy to .env.local and fill in from the Firebase console once the project
# exists (Project settings → General → Your apps → SDK setup and config).
# These are the public client SDK config values — safe to expose in the
# browser bundle; access control is enforced by Firestore/Storage rules and
# Auth custom claims, not by keeping this config secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
