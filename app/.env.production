# Committed (unlike .env.local) so `npm run build` produces a working
# client bundle in CI (.github/workflows/rebuild-and-deploy.yml), which
# checks out a fresh repo with no .env.local. These are the same public
# Firebase client SDK config values as .env.example/.env.local — safe to
# commit and expose in the browser bundle (access control is enforced by
# Firestore/Storage rules and Auth custom claims, not by keeping this
# config secret; see .env.example's own comment). Locally, .env.local
# still takes precedence over this file per Vite's env-file precedence, so
# nothing changes for local dev — this only matters when .env.local is
# absent, i.e. in CI.
VITE_FIREBASE_API_KEY=AIzaSyB6EeFh4y4qkGn9oiEXOkplm3DFT1whG-U
VITE_FIREBASE_AUTH_DOMAIN=bairesrental.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bairesrental
VITE_FIREBASE_STORAGE_BUCKET=bairesrental.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=654252544387
VITE_FIREBASE_APP_ID=1:654252544387:web:1187f66e5fd1dafee226b6
