# Parámetros de la extensión `firebase/storage-resize-images`.
#
# Para qué está: genera, ante cada upload, un derivado 1200x630 de cada foto
# subida, que es lo que se publica en og:image para los previews de link
# (WhatsApp, Facebook, X, LinkedIn). Las portadas originales son fotos de
# celular de 2-4 MB y verticales; WhatsApp descarta cualquier og:image de más
# de ~300 KB y todas las plataformas esperan un apaisado ~1.91:1.
#
# El derivado queda al lado del original con el sufijo `_1200x630`:
#   rentals/Baires/cover.jpg -> rentals/Baires/cover_1200x630.jpg
# que es exactamente la URL que arma app/utils/ogImage.ts.
#
# Se despliega con:  firebase deploy --only extensions --project bairesrental
# Ver la sección "Previews de link" del README.

# Misma región que el bucket (SOUTHAMERICA-EAST1) y que el resto de las
# functions del proyecto. Un trigger de Storage tiene que vivir donde vive el
# bucket.
#
# OJO CON EL NOMBRE: la región NO se configura con `LOCATION`. Es un
# *system param* de Firebase Extensions y va con su nombre completo. Escrito
# como `LOCATION=` el CLI lo ignora en silencio —no falla, no avisa— y la
# extensión se instala en us-central1, el default.
#
# Eso pasó de verdad: la instancia quedó en us-central1 con el bucket en
# southamerica-east1, el trigger de Storage nunca se disparó (un trigger tiene
# que estar en la región del bucket) y encima la instancia terminó en estado
# ERRORED porque el deploy de la función Gen1 falló ahí. Todos los demás
# parámetros de este archivo sí habían agarrado bien — sólo este.
firebaseextensions.v1beta.function/location=southamerica-east1

IMG_BUCKET=bairesrental.firebasestorage.app

# Un solo tamaño. Es la medida canónica de Open Graph (1.91:1).
IMG_SIZES=1200x630

# Estas opciones se spreadean sobre los defaults de la extensión, que son
# `{ fit: "inside", withoutEnlargement: true }` (ver resize-image.ts upstream),
# y las dos hay que pisarlas:
#  - `cover` recorta al rectángulo pedido en vez de encajar la foto adentro;
#    con `inside` una vertical de 3024x4032 saldría 472x630.
#  - `withoutEnlargement: false` porque si no, una portada más chica que
#    1200x630 sale más chica todavía.
# En los dos casos el problema no es solo estético: las fichas declaran
# og:image:width/height en 1200x630, así que el output tiene que ser
# exactamente eso o el meta miente y la tarjeta sale mal dibujada.
SHARP_OPTIONS={"fit":"cover","position":"centre","withoutEnlargement":false}

# Solo las carpetas del catálogo — el bucket no tiene otra cosa hoy, pero deja
# el alcance explícito por si mañana se guarda algo que no sea una foto.
INCLUDE_PATH_LIST=/rentals,/sales

# El original NO se toca: es el que se sigue mostrando en la ficha y en la
# galería a tamaño completo. El derivado es solo para el preview.
DELETE_ORIGINAL_FILE=false

# Mantener el formato de origen (hay portadas .jpg y .png). Convertir haría
# que la extensión cambie la extensión del archivo y la URL que construye
# ogImage.ts dejaría de coincidir.
IMAGE_TYPE=false

# No hace falta ACL público: storage.rules ya tiene `allow read: if true` en
# rentals/** y sales/**, así que la URL con `?alt=media` y sin token resuelve.
MAKE_PUBLIC=false
REGENERATE_TOKEN=true

IS_ANIMATED=true
CACHE_CONTROL_HEADER=public, max-age=31536000
FUNCTION_MEMORY=1024
CONTENT_FILTER_LEVEL=OFF
