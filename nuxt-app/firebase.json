{
  "functions": {
    "source": ".output/server",
    "codebase": "nuxtssr"
  },
  "hosting": {
    "site": "bairesrental",
    "public": ".output/public",
    "cleanUrls": true,
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/departamentos.html", "destination": "/departamentos", "type": 301 },
      { "source": "/ventas.html", "destination": "/ventas", "type": 301 },
      { "source": "/tickets.html", "destination": "/tickets", "type": 301 },
      { "source": "/catalogo-vendedores.html", "destination": "/app/login", "type": 301 },
      { "source": "/ficha-vendedor.html", "destination": "/app/login", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": { "functionId": "nuxtSsr", "region": "southamerica-east1" }
      }
    ]
  }
}
