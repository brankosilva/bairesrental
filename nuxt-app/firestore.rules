rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Catálogo (rentals / sales) ──────────────────────────────────────
    //
    // Público, pero SÓLO lo que ya aprobó un admin: lo que carga un vendedor
    // pasa por revisión antes de salir al sitio.
    //
    // Las dos colecciones tienen reglas idénticas, y la lógica vive en estas
    // funciones en vez de repetirse en cada match justamente para que no
    // puedan divergir.

    // POR QUÉ `get` Y `list` SON DISTINTOS, que es lo no obvio de este bloque.
    //
    // `get` se evalúa contra el DOCUMENTO real, así que `.get(campo, default)`
    // es legal y hace lo que dice: una propiedad vieja sin el campo (las ~88
    // que cargó el admin por script) se lee como aprobada.
    //
    // `list` NO se evalúa documento por documento: Firestore chequea la QUERY
    // contra la regla y deniega la request entera si no puede PROBAR que todo
    // resultado posible pasa ("rules are not filters"). Ese analizador
    // reconoce sólo comparaciones simples contra un campo, no llamadas a
    // método como `.get()`. Con `.get(...)` acá, la query anónima REBOTA
    // ENTERA y el catálogo público sale vacío — no "con menos propiedades".
    // Por eso tiene que ser la comparación literal, y por eso las queries
    // públicas llevan where('revision','==','aprobada').
    //
    // Corolario, y la razón de que el backfill no sea opcional: un `where` de
    // igualdad no matchea documentos sin el campo. Uno sin `revision` abriría
    // por URL directa pero no aparecería ni en el catálogo ni en el sitemap.
    // Ver app/utils/revision.ts y scripts/lib/catalogo.js.
    //
    // Y OJO CON EL ORDEN: `isSignedIn()` va PRIMERO en las dos. En Rules leer
    // una clave que no existe es un ERROR de evaluación, no `false`, y `||`
    // cortocircuita. Al revés, un documento legacy sin `revision` sería
    // ilegible hasta para el admin.
    function puedeLeerPropiedad() {
      return isSignedIn() || resource.data.get('revision', 'aprobada') == 'aprobada';
    }

    function puedeListarPropiedades() {
      return isSignedIn() || resource.data.revision == 'aprobada';
    }

    // `.get('sellerUid', '')` por lo mismo: los ~88 documentos legacy no
    // tienen el campo y leerlo directo sería un error de evaluación.
    function esDelVendedor() {
      return role() == 'seller' && resource.data.get('sellerUid', '') == request.auth.uid;
    }

    function camposTocados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function creaElVendedor() {
      return role() == 'seller'
        && request.resource.data.get('sellerUid', '') == request.auth.uid
        // Sin esto el vendedor se auto-publica en el alta y todo lo demás no
        // sirve para nada.
        && request.resource.data.revision == 'pendiente'
        && !request.resource.data.keys().hasAny(['motivoRechazo', 'revisadaPor', 'revisadaEn']);
    }

    function editaElVendedor() {
      return esDelVendedor()
        // El pin que faltaba, y que no es de esta feature: la regla vieja sólo
        // miraba el documento EXISTENTE, así que un vendedor podía
        // reasignarse la propiedad a otro uid —o dejarla sin dueño— y
        // perderla para siempre.
        && request.resource.data.get('sellerUid', '') == request.auth.uid
        && (
          // El cambio rápido de disponibilidad desde la lista NO manda nada a
          // revisión: no toca lo que el admin aprobó. Si lo hiciera, un
          // vendedor marcando "reservado" se bajaría su propia publicación del
          // sitio. El set es exactamente ['disponibilidad','updatedAt'] porque
          // useAvailability() llama a saveOne(), que sella updatedAt siempre.
          (camposTocados().hasOnly(['disponibilidad', 'updatedAt'])
           && !camposTocados().hasAny(['revision', 'motivoRechazo', 'revisadaPor', 'revisadaEn']))

          // Cualquier otra edición deja el documento EN REVISIÓN.
          //
          // Se mira el documento RESULTANTE y no lo que mandó el cliente, y
          // ésa es la diferencia entre que ande y que no: el formulario guarda
          // DOS veces (primero los campos, después saveOne(id, { imagen }) con
          // la foto ya subida), y esa segunda escritura no reenvía `revision`.
          // En un merge `request.resource.data` es lo que QUEDA, así que las
          // dos pasan.
          || (request.resource.data.revision == 'pendiente'
              && !camposTocados().hasAny(['motivoRechazo', 'revisadaPor', 'revisadaEn']))
        );
      // A propósito NO hay un keys().hasOnly([...]) con los campos de la
      // propiedad. RentalProperty/SaleProperty tienen ~40 campos y cambian
      // seguido: el día que alguien agregue uno al formulario y se olvide de
      // esta regla, se romperían TODOS los guardados de los vendedores sin que
      // nada avise. Las restricciones de acá son negativas y sobre lo que
      // CAMBIÓ (affectedKeys), que es lo que resiste que el esquema se mueva —
      // el formulario hace Object.assign(form, existing) y reenvía
      // motivoRechazo tal cual vino, y eso no cuenta como afectado. Con
      // keys().hasAny() le rechazaría al vendedor todo guardado posterior a un
      // rechazo. Misma lección que sellerProfiles más abajo.
      //
      // El vendedor tampoco puede LIMPIAR motivoRechazo, y es deliberado: el
      // historial queda para el admin, y la UI lo muestra sólo cuando
      // revision == 'rechazada' (ver app/utils/revision.ts), así que un motivo
      // viejo nunca aparece sobre una propiedad ya corregida.
    }

    match /rentals/{id} {
      allow get: if puedeLeerPropiedad();
      allow list: if puedeListarPropiedades();
      allow create: if isAdmin() || creaElVendedor();
      allow update: if isAdmin() || editaElVendedor();
      allow delete: if isAdmin() || esDelVendedor();
    }

    match /sales/{id} {
      allow get: if puedeLeerPropiedad();
      allow list: if puedeListarPropiedades();
      allow create: if isAdmin() || creaElVendedor();
      allow update: if isAdmin() || editaElVendedor();
      allow delete: if isAdmin() || esDelVendedor();
    }

    // Owners get read access to their own properties (v1 scope is
    // read-only — see docs/negocio.md's owner-portal requirement); since
    // `rentals`/`sales` read is already public above, no extra owner-only
    // read rule is needed today, but the ownerUid field exists on both
    // collections for the owner-portal UI to filter on client-side queries.

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Role changes only via the setUserRole Cloud Function (Admin SDK,
      // bypasses rules) so the auth custom claim and this doc never drift
      // out of sync — no direct client writes, even by admins.
      allow write: if false;
    }

    // Document ID IS the shareable short code (e.g. links/ab3f9k).
    //
    // El `allow get: if true` que había acá SE SACÓ. Existía para que la
    // ruta /l/:code pudiera resolver el link con el SDK cliente, pero los
    // documentos llevan `note` —lo que el vendedor anotó sobre el cliente
    // al que se lo mandó—, y dejarlos legibles por cualquiera que tuviese
    // el código publicaba datos de un tercero. Ahora esa ruta lee con el
    // Admin SDK (server/utils/linkTracking.ts), que no pasa por reglas.
    //
    // `list` ("mis links") exige que la query filtre por sellerUid;
    // Firestore lo valida estáticamente contra esta regla.
    match /links/{code} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);

      // Crear pasa SIEMPRE por un callable (createTrackableLink o
      // ensureSellerLink, los dos con Admin SDK, que saltea reglas). La
      // regla anterior permitía que un vendedor escribiera el documento
      // directo desde el cliente, con los contadores que quisiera y
      // salteándose la validación de que la propiedad exista.
      allow create: if false;

      // El vendedor etiqueta y desactiva sus propios links; los contadores
      // no los toca nadie desde el cliente.
      //
      // El link personal (`primary`) es la excepción: NO se puede
      // desactivar. Es la URL que el vendedor tiene puesta en la bio de
      // Instagram y en su firma, nadie la vuelve a crear si la apaga, y
      // apagarla no le sirve para nada — no es un link de un cliente.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['label', 'labelLower', 'channel', 'note', 'outcome', 'active', 'updatedAt'])
            && (resource.data.get('primary', false) != true
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active'])));

      // `leads` referencia links por linkId: borrar uno rompe el historial
      // de atribución. deleteUser ya desactiva en vez de borrar.
      allow delete: if isAdmin();

      // El evento lleva `sellerUid` desnormalizado justamente para que
      // esta regla no necesite un get() al documento padre — que se
      // cobraría como una lectura por cada evaluación de la regla. Las
      // queries filtran por sellerUid y ordenan del lado del cliente,
      // misma convención de "sin índices compuestos" que leads.vue.
      match /opens/{eventId} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
        // Sólo el Admin SDK. Un contador que el público pueda escribir se
        // infla con un `curl` en un bucle, y las reglas no pueden expresar
        // el filtro de User-Agent que distingue una persona de un scraper.
        allow write: if false;
      }
    }

    // Ficha pública del vendedor: lo que ve el cliente en la página que le
    // compartieron (foto, nombre, su WhatsApp).
    //
    // Deliberadamente SEPARADO de users/{uid}, que sigue siendo privado:
    // users.phone es un contacto interno que administra el admin, y
    // sellerProfiles.whatsapp es un número publicado. Tienen que poder
    // diferir, y un admin editando el contacto interno de alguien no puede
    // cambiarle sin querer lo que aparece en una página pública.
    match /sellerProfiles/{uid} {
      allow get: if true;
      allow list: if isAdmin();

      // Forma del documento, mire quien lo escriba.
      function fichaValida() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'displayName', 'title', 'photoUrl', 'whatsapp', 'bio', 'instagram',
                  'logoUrl', 'accentColor', 'slug', 'active', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && (!('bio' in request.resource.data) || request.resource.data.bio == null
              || request.resource.data.bio.size() <= 280);
      }

      // Lo que el vendedor puede tocar de su propia ficha. `active`
      // (despublicar) y `slug` (necesita un chequeo de unicidad que una
      // regla no puede hacer) son sólo del admin.
      function camposDelVendedor() {
        return ['uid', 'displayName', 'title', 'photoUrl', 'whatsapp', 'bio',
                'instagram', 'logoUrl', 'accentColor', 'updatedAt'];
      }

      allow create: if fichaValida()
        && (isAdmin()
            || (role() == 'seller' && request.auth.uid == uid
                && !request.resource.data.keys().hasAny(['active', 'slug'])));

      // OJO con la diferencia entre create y update: en un update
      // `request.resource.data` es el documento RESULTANTE (lo que había
      // más el parche), no lo que mandó el cliente. Como inviteUser siembra
      // la ficha con `active: true` y `slug: null` (ensureSellerProfile),
      // pedirle acá lo mismo que al create —que no aparezcan esas claves—
      // le rechazaba TODOS los guardados al vendedor, aunque no las
      // mandara. Lo que hay que mirar es qué cambió: affectedKeys().
      allow update: if fichaValida()
        && (isAdmin()
            || (role() == 'seller' && request.auth.uid == uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(camposDelVendedor())));

      allow delete: if isAdmin();
    }

    match /leads/{id} {
      // Public lead capture (the submitLead Cloud Function) uses the Admin
      // SDK and bypasses these rules by design — anonymous visitors submit
      // leads through the function, never via a direct client write.
      allow read, update: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAdmin() || (role() == 'seller' && request.resource.data.sellerUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
