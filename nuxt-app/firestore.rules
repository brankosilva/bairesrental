rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public catalog — same visibility as today's fully-public JSON files.
    // Sellers may only create/edit/delete their own listings (sellerUid
    // must equal the caller's uid on both the existing doc and the write).
    match /rentals/{id} {
      allow read: if true;
      allow create: if isAdmin() || (role() == 'seller' && request.resource.data.sellerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (role() == 'seller' && resource.data.sellerUid == request.auth.uid);
    }

    match /sales/{id} {
      allow read: if true;
      allow create: if isAdmin() || (role() == 'seller' && request.resource.data.sellerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (role() == 'seller' && resource.data.sellerUid == request.auth.uid);
    }

    // Owners get read access to their own properties (v1 scope is
    // read-only — see docs/negocio.md's owner-portal requirement); since
    // `rentals`/`sales` read is already public above, no extra owner-only
    // read rule is needed today, but the ownerUid field exists on both
    // collections for the owner-portal UI to filter on client-side queries.

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Role changes only via the setUserRole Cloud Function (Admin SDK,
      // bypasses rules) so the auth custom claim and this doc never drift
      // out of sync — no direct client writes, even by admins.
      allow write: if false;
    }

    // Document ID IS the shareable short code (e.g. links/ab3f9k).
    //
    // El `allow get: if true` que había acá SE SACÓ. Existía para que la
    // ruta /l/:code pudiera resolver el link con el SDK cliente, pero los
    // documentos llevan `note` —lo que el vendedor anotó sobre el cliente
    // al que se lo mandó—, y dejarlos legibles por cualquiera que tuviese
    // el código publicaba datos de un tercero. Ahora esa ruta lee con el
    // Admin SDK (server/utils/linkTracking.ts), que no pasa por reglas.
    //
    // `list` ("mis links") exige que la query filtre por sellerUid;
    // Firestore lo valida estáticamente contra esta regla.
    match /links/{code} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);

      // Crear pasa SIEMPRE por un callable (createTrackableLink o
      // ensureSellerLink, los dos con Admin SDK, que saltea reglas). La
      // regla anterior permitía que un vendedor escribiera el documento
      // directo desde el cliente, con los contadores que quisiera y
      // salteándose la validación de que la propiedad exista.
      allow create: if false;

      // El vendedor etiqueta y desactiva sus propios links; los contadores
      // no los toca nadie desde el cliente.
      //
      // El link personal (`primary`) es la excepción: NO se puede
      // desactivar. Es la URL que el vendedor tiene puesta en la bio de
      // Instagram y en su firma, nadie la vuelve a crear si la apaga, y
      // apagarla no le sirve para nada — no es un link de un cliente.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['label', 'labelLower', 'channel', 'note', 'outcome', 'active', 'updatedAt'])
            && (resource.data.get('primary', false) != true
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active'])));

      // `leads` referencia links por linkId: borrar uno rompe el historial
      // de atribución. deleteUser ya desactiva en vez de borrar.
      allow delete: if isAdmin();

      // El evento lleva `sellerUid` desnormalizado justamente para que
      // esta regla no necesite un get() al documento padre — que se
      // cobraría como una lectura por cada evaluación de la regla. Las
      // queries filtran por sellerUid y ordenan del lado del cliente,
      // misma convención de "sin índices compuestos" que leads.vue.
      match /opens/{eventId} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
        // Sólo el Admin SDK. Un contador que el público pueda escribir se
        // infla con un `curl` en un bucle, y las reglas no pueden expresar
        // el filtro de User-Agent que distingue una persona de un scraper.
        allow write: if false;
      }
    }

    // Ficha pública del vendedor: lo que ve el cliente en la página que le
    // compartieron (foto, nombre, su WhatsApp).
    //
    // Deliberadamente SEPARADO de users/{uid}, que sigue siendo privado:
    // users.phone es un contacto interno que administra el admin, y
    // sellerProfiles.whatsapp es un número publicado. Tienen que poder
    // diferir, y un admin editando el contacto interno de alguien no puede
    // cambiarle sin querer lo que aparece en una página pública.
    match /sellerProfiles/{uid} {
      allow get: if true;
      allow list: if isAdmin();

      // Forma del documento, mire quien lo escriba.
      function fichaValida() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'displayName', 'title', 'photoUrl', 'whatsapp', 'bio', 'instagram',
                  'logoUrl', 'accentColor', 'slug', 'active', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && (!('bio' in request.resource.data) || request.resource.data.bio == null
              || request.resource.data.bio.size() <= 280);
      }

      // Lo que el vendedor puede tocar de su propia ficha. `active`
      // (despublicar) y `slug` (necesita un chequeo de unicidad que una
      // regla no puede hacer) son sólo del admin.
      function camposDelVendedor() {
        return ['uid', 'displayName', 'title', 'photoUrl', 'whatsapp', 'bio',
                'instagram', 'logoUrl', 'accentColor', 'updatedAt'];
      }

      allow create: if fichaValida()
        && (isAdmin()
            || (role() == 'seller' && request.auth.uid == uid
                && !request.resource.data.keys().hasAny(['active', 'slug'])));

      // OJO con la diferencia entre create y update: en un update
      // `request.resource.data` es el documento RESULTANTE (lo que había
      // más el parche), no lo que mandó el cliente. Como inviteUser siembra
      // la ficha con `active: true` y `slug: null` (ensureSellerProfile),
      // pedirle acá lo mismo que al create —que no aparezcan esas claves—
      // le rechazaba TODOS los guardados al vendedor, aunque no las
      // mandara. Lo que hay que mirar es qué cambió: affectedKeys().
      allow update: if fichaValida()
        && (isAdmin()
            || (role() == 'seller' && request.auth.uid == uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(camposDelVendedor())));

      allow delete: if isAdmin();
    }

    match /leads/{id} {
      // Public lead capture (the submitLead Cloud Function) uses the Admin
      // SDK and bypasses these rules by design — anonymous visitors submit
      // leads through the function, never via a direct client write.
      allow read, update: if isAdmin() || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
      allow create: if isAdmin() || (role() == 'seller' && request.resource.data.sellerUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
